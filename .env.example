# Copy to .env and adjust. The hub (npm start) and the agent (npm run agent) read the same file,
# each using only its own settings.

# ============================== Hub ==============================

# REQUIRED: login password (min. 12 chars). Connected machines can run arbitrary commands — use a strong one.
APP_PASSWORD=

# Optional but strongly recommended when exposed to the internet: TOTP second factor.
# Generate with: npm run totp-setup
TOTP_SECRET=

# Where the hub listens. Nginx Proxy Manager forwards to this.
HOST=0.0.0.0
PORT=3456

# Public URL of the hub, shown in the setup snippet when adding a machine (defaults to the URL in the browser).
PUBLIC_URL=

# Which proxies to trust for X-Forwarded-* (Express "trust proxy" syntax). Default covers LAN/Docker ranges.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Also serve this machine's projects from inside the hub process (no separate agent needed here).
# Requires the Claude Agent SDK to be installed. Uses the agent settings below.
EMBEDDED_AGENT=true

# Login cookie lifetime in days.
SESSION_TTL_DAYS=14

# ============================== Agent ==============================

# Only for a standalone agent (npm run agent) on another PC: the hub's URL and this machine's token
# (create it in the web UI under Machines → Add).
HUB_URL=
AGENT_TOKEN=

# Folder whose subfolders are shown as projects for this machine.
BASE_DIR=C:\Users\<you>\source\repos

# Permission mode for new sessions: default | acceptEdits | plan | auto | dontAsk
DEFAULT_PERMISSION_MODE=default

# Allow selecting "bypassPermissions" in the UI for this machine (dangerous).
ALLOW_BYPASS_PERMISSIONS=false

# Close live sessions after this many idle minutes (0 = never). They can be resumed any time.
IDLE_CLOSE_MINUTES=120
