# Copy to .env and adjust.

# REQUIRED: login password (min. 12 chars). This app can run arbitrary commands on your machine — use a strong one.
APP_PASSWORD=

# Optional but strongly recommended when exposed to the internet: TOTP second factor.
# Generate with: npm run totp-setup
TOTP_SECRET=

# Folder whose subfolders are shown as projects.
BASE_DIR=C:\Users\<you>\source\repos

# Where the server listens. Nginx Proxy Manager forwards to this.
# Use 127.0.0.1 if NPM runs on this machine (not in Docker), otherwise 0.0.0.0 and firewall the port to NPM's IP.
HOST=0.0.0.0
PORT=3456

# Which proxies to trust for X-Forwarded-* (Express "trust proxy" syntax). Default covers LAN/Docker ranges.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Permission mode for new sessions: default | acceptEdits | plan | auto | dontAsk
DEFAULT_PERMISSION_MODE=default

# Allow selecting "bypassPermissions" in the UI (dangerous).
ALLOW_BYPASS_PERMISSIONS=false

# Close live sessions after this many idle minutes (0 = never). They can be resumed any time.
IDLE_CLOSE_MINUTES=120

# Login cookie lifetime in days.
SESSION_TTL_DAYS=14
